<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DeveloperPortfolio</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/portfolio.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DeveloperPortfolio.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="portfolio-navbar">

            <div class="navbar-container">

                <!-- Logo / Name -->
                <a class="navbar-logo" href="#home">
                    Sivananth<span>.</span>
                </a>

                <!-- Navigation -->
                <ul class="navbar-menu">

                    <li>
                        <a href="#home">Home</a>
                    </li>

                    <li>
                        <a href="#about">About</a>
                    </li>

                    <li>
                        <a href="#skills">Skills</a>
                    </li>

                    <li>
                        <a href="#projects">Projects</a>
                    </li>

                    <li>
                        <a href="#experience">Experience</a>
                    </li>

                    <li>
                        <a href="#education">Education</a>
                    </li>

                    <li>
                        <a href="#contact">Contact</a>
                    </li>

                    <li>
                        <a href="~/resume/Sivananth_K_Resume.pdf"
                               target="_blank"
                               download>
                            Resume
                        </a>
                    </li>

                </ul>

                <!-- Mobile menu button -->
                <button class="menu-toggle" id="menuToggle">
                    ☰
                </button>

            </div>

        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - DeveloperPortfolio - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
